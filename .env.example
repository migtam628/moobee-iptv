DOMAIN=tv.moobee.lol
PUBLIC_URL=https://tv.moobee.lol
ADMIN_DOMAIN=admin.moobee.lol
ADMIN_USERNAME=admin
# Use a generated unique password of at least 20 characters; do not commit real credentials.
ADMIN_PASSWORD=

# Disabled-by-default MooBee Stream integration.
# Only fixed private IPv4 or exact opt-in Tailscale Serve HTTPS hostname.
# Keep BOTH feature flags false on production unless independently approved.
MOOBEE_STREAM_ENABLED=false
MOOBEE_STREAM_BASE_URL=
# Exact *.ts.net hostname only, no URL scheme or port; leave empty by default.
MOOBEE_STREAM_TAILSCALE_HOSTNAME=
MOOBEE_STREAM_SERVICE_KEY=

# Independent playback gate; stays disabled even if catalog preview is enabled.
MOOBEE_STREAM_PLAYBACK_ENABLED=false
# Independent signing secret (>=32 random bytes). Required ONLY if remote playback enabled.
# Generated on the server, never reuse STREAM_SERVICE_API_KEY, never commit real values.
MOOBEE_STREAM_HLS_TOKEN_SECRET=
