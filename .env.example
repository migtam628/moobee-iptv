DOMAIN=tv.moobee.lol
PUBLIC_URL=https://tv.moobee.lol
ADMIN_DOMAIN=admin.moobee.lol
ADMIN_USERNAME=admin
# Use a generated unique password of at least 20 characters; do not commit real credentials.
ADMIN_PASSWORD=

# MooBee Stream metadata integration (admin only; playback disabled by default).
# Keep disabled on production until approved staging validation.
# Numeric private IPv4 still supported; remote access requires verified HTTPS.
# Optional: explicitly allow exactly one Tailscale Serve *.ts.net host (HTTPS/443).
# This is the hostname ONLY, with no scheme, slash, or port.
# MOOBEE_STREAM_BASE_URL=https://moobee-stream-vps.tail08e9d7.ts.net
# MOOBEE_STREAM_TAILSCALE_HOSTNAME=moobee-stream-vps.tail08e9d7.ts.net
MOOBEE_STREAM_ENABLED=false
MOOBEE_STREAM_BASE_URL=
MOOBEE_STREAM_TAILSCALE_HOSTNAME=
MOOBEE_STREAM_SERVICE_KEY=
